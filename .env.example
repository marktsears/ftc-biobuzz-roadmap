# ── Shared storage (free Supabase project) ─────────────────────────────
# Leave these empty to run in "local mode": everything still works, but each
# person's progress only lives in their own browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: a shared word to keep strangers from ticking boxes ───────
# If set, people must type this once (Profile → Team code) before they can save.
# Reading the site never needs it.
TEAM_CODE=
