# ── Google sign-in (Trinity School Workspace, @tsdch.org) ──────────────
# Create a Web OAuth client in Google Cloud, then paste the id and secret.
# Authorized redirect URIs:
#   https://ftc-biobuzz-roadmap.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# AUTH_SECRET can be any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_DOMAIN=tsdch.org
# More Google addresses, besides @tsdch.org and msears@gmail.com. Comma-separated.
# AUTH_ALLOWED_EMAILS=coach@gmail.com

# ── Shared storage (free Supabase project) ─────────────────────────────
# Leave these empty to run in "local mode": everything still works, but each
# person's progress only lives in their own browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: a shared word to keep strangers from ticking boxes ───────
# If set, people must type this once (Profile → Team code) before they can save.
# Reading the site never needs it.
TEAM_CODE=
